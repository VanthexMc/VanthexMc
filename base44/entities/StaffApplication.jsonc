{
  "name": "StaffApplication",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome del giocatore (IGN o nickname)"
    },
    "requested_role": {
      "type": "string",
      "enum": [
        "Moderatore",
        "Helper",
        "Developer",
        "Builder",
        "Content Creator"
      ],
      "description": "Ruolo per cui si candida"
    },
    "experience": {
      "type": "string",
      "description": "Esperienza precedente rilevante"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewing",
        "accepted",
        "rejected"
      ],
      "default": "pending",
      "description": "Stato della candidatura"
    }
  },
  "required": [
    "name",
    "requested_role",
    "experience"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}